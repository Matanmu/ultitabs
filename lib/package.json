{
  "name": "ultitabs",
  "version": "1.6.0",
  "description": "Zero-dependency tab library with accessible, animated tabs and RTL support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./css": "./css/ultitabs.css",
    "./css/ultitabs.min.css": "./css/ultitabs.min.css"
  },
  "files": [
    "dist",
    "css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "lightningcss --minify --bundle css/ultitabs.css -o css/ultitabs.min.css",
    "dev": "tsup --watch",
    "clean": "rm -rf dist css/ultitabs.min.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^29.0.1",
    "lightningcss-cli": "^1.28.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs",
    "./css/*.css"
  ],
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "4.6 kB",
      "gzip": true
    },
    {
      "path": "css/ultitabs.min.css",
      "limit": "2.1 kB",
      "gzip": true
    }
  ],
  "license": "MIT",
  "keywords": [
    "tabs",
    "tab",
    "tablist",
    "tabpanel",
    "aria",
    "accessible",
    "animated",
    "indicator",
    "rtl",
    "zero-dependency",
    "vanilla",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Matanmu/ultitabs.git"
  },
  "homepage": "https://github.com/Matanmu/ultitabs#readme",
  "bugs": {
    "url": "https://github.com/Matanmu/ultitabs/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
